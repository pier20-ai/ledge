{
  "name": "ledge-host",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "start": "bun src/host.ts",
    "//build": "Two entrypoints: the worker entry must be embedded under its own name or `new Worker(…)` cannot resolve it inside the binary (src/worker-entry.ts). The signature bun emits does not validate, so the bundle script strips and re-signs it (scripts/bundle-app.sh).",
    "build": "bun build --compile src/host.ts src/worker-entry.ts --outfile dist/ledge",
    "fake-shell": "bun src/fakes/fake-shell.ts",
    "test": "bash scripts/test-stable.sh",
    "start:demos": "bun src/host.ts --apps-root ../protocol/demo-apps",
    "test:fast": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/react": "18.3.12",
    "@types/react-reconciler": "0.28.8",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-reconciler": "0.29.2"
  }
}
